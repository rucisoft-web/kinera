APP_NAME="Kinera"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://kinera.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- MySQL / MariaDB (bawaan Laragon: user root, tanpa kata sandi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kinera
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# produksi (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rucisoft@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Kinera (edisi Badan Layanan Umum, PER-6/PB/2025)
KINERA_TERMS=blu
KINERA_BRAND_NAME="Kinera"
KINERA_BRAND_TAGLINE="Balanced Scorecard & Kontrak Kinerja Pemimpin BLU"
KINERA_DEMO_ENABLED=false
KINERA_GUEST_LOGIN=false
KINERA_GUEST_EMAIL=tamu@demo.rucisoft.id
# Workshop 2 hari: kosongkan URL agar tombol Daftar membuka WhatsApp di bawah
KINERA_WORKSHOP_URL=
KINERA_WORKSHOP_CONTACT=
KINERA_WORKSHOP_TEMPAT=
KINERA_WORKSHOP_TANGGAL=
KINERA_WORKSHOP_BIAYA=
# Kontak di halaman depan: nomor WhatsApp (format 62…) dan email
KINERA_CONTACT_WHATSAPP=6281199892939
KINERA_CONTACT_EMAIL=rucisoft@gmail.com
KINERA_AUDIT_ENABLED=true
# Kirim notifikasi juga lewat email (butuh MAIL_* yang benar)
KINERA_NOTIFY_MAIL=false
# Wajibkan 2FA (aplikasi autentikator) untuk Pimpinan, Pengawas & admin
KINERA_MFA_REQUIRED=false
# Muat data demo satker BLU (UIN Sunan Kalijaga) walau APP_ENV=production
KINERA_SEED_DEMO=false
